ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY filegate-core/target/filegate-core-0.1.0-SNAPSHOT.jar /app/core.jar
COPY filegate-worker/target/filegate-worker-0.1.0-SNAPSHOT.jar /app/worker.jar
COPY filegate-worker/target/worker-test-fixtures.jar /app/test-fixtures.jar
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["java"]
