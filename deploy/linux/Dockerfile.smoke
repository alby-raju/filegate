ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY filegate-core/target/filegate-core-0.1.0-SNAPSHOT.jar /app/core.jar
COPY filegate-worker/target/filegate-worker-0.1.0-SNAPSHOT.jar /app/worker.jar
COPY filegate-worker/target/worker-test-fixtures.jar /app/test-fixtures.jar
COPY filegate-format-images/target/filegate-format-images-0.1.0-SNAPSHOT.jar /app/images.jar
COPY filegate-images-worker/target/filegate-images-worker-0.1.0-SNAPSHOT.jar /app/images-worker.jar
COPY filegate-format-office/target/filegate-format-office-0.1.0-SNAPSHOT.jar /app/office.jar
COPY filegate-format-spreadsheets/target/filegate-format-spreadsheets-0.1.0-SNAPSHOT.jar /app/spreadsheets.jar
COPY filegate-spreadsheets-worker/target/filegate-spreadsheets-worker-0.1.0-SNAPSHOT.jar /app/spreadsheets-worker.jar
COPY filegate-spreadsheets-worker/target/worker-libs/ /app/
COPY filegate-spreadsheets-worker/target/spreadsheet-test-fixtures.jar /app/spreadsheet-test-fixtures.jar
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["java"]
